<!DOCTYPE html>
{% set theme = app.user.theme ?? null %}
<html lang="{{ app.request.locale }}"{% if (app.user.design.value ?? null) == 'cozy' %} data-design="cozy"{% endif %}{% if theme %} style="--theme-background: {{ theme.background }}; --theme-accent: {{ theme.accent }}; color-scheme: {{ theme.dark ? 'dark' : 'light' }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#f5f5f3">
        <title>{% block title %}MossyDew{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="/icons/mossydew.svg">
        <link rel="manifest" href="/manifest.webmanifest">
        <link rel="apple-touch-icon" href="/icons/mossydew-192.png">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body data-locale="{{ app.request.locale }}">
        {% block body %}{% endblock %}
    </body>
</html>
