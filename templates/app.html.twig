{% extends 'base.html.twig' %}

{% block stylesheets %}{{ vite_entry_link_tags('app') }}{% endblock %}
{% block javascripts %}{{ vite_entry_script_tags('app') }}{% endblock %}

{% block body %}
    <script type="application/json" id="app-session">{{ {
        email: app.user.email,
        displayName: app.user.displayName,
        language: app.user.language.value ?? null,
        theme: app.user.theme ? {background: app.user.theme.background, accent: app.user.theme.accent} : null,
        design: app.user.design.value,
        icons: app.user.iconSet.value,
        mysteries: app.user.mysteries,
        logoutToken: csrf_token('logout'),
        accountsUrl: accounts_url,
    }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
    <script type="application/json" id="app-preload">{{ preloaded|raw }}</script>
    <div id="app"></div>
{% endblock %}
